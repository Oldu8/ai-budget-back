APP_NAME="Vtrata"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ai_budget
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase is used only as Postgres (DB_*) and Storage (receipts). Auth is handled by Laravel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
SUPABASE_STORAGE_BUCKET=receipts

# Own JWT auth. JWT_SECRET: generate a long random string (e.g. `php -r "echo bin2hex(random_bytes(32));"`).
JWT_SECRET=
# JWT_TTL=900           # access token lifetime, seconds (default 15 min)
# JWT_REFRESH_TTL=2592000  # refresh token lifetime, seconds (default 30 days)
# JWT_ISSUER=           # defaults to APP_URL

# Social sign-in: allowed OAuth client ids (the `aud` of the id_token). Comma-separated for iOS/Android/Web.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# OpenAI — voice expenses only (Whisper transcription + expense text parsing).
OPENAI_API_KEY=
# Optional; defaults to whisper-1. Set when OpenAI replaces the audio transcription model name.
# OPENAI_AUDIO_MODEL=whisper-1

# Gemini — receipt scanning, via Google's OpenAI-compatible endpoint.
# Key from aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.1-flash-lite.
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Optional override; defaults to Google's endpoint. No trailing slash (the
# client appends one). Point at https://api.openai.com/v1 with an OpenAI key
# in GEMINI_API_KEY to run scans on OpenAI models again.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Resolved from APP_URL at load time; override with a full URL (e.g. deep link) if needed
STRIPE_SUCCESS_URL=${APP_URL}/stripe/checkout/success
STRIPE_CANCEL_URL=${APP_URL}/stripe/checkout/cancel
# Where the billing portal returns the user (separate web page from checkout success).
# Falls back to STRIPE_SUCCESS_URL if empty.
STRIPE_PORTAL_RETURN_URL=${APP_URL}/stripe/portal/return
STRIPE_BASIC_PRICE_EUR=
STRIPE_BASIC_PRICE_USD=
STRIPE_PLUS_PRICE_EUR=
STRIPE_PLUS_PRICE_USD=
STRIPE_PREMIUM_PRICE_EUR=
STRIPE_PREMIUM_PRICE_USD=

# Admin panel (table users). Used by AdminUserSeeder.
ADMIN_PASSWORD=

# Google Analytics 4 (gtag.js) for the public site/blog. Set in prod only so dev doesn't send hits.
# Doubles as Search Console verification (method: "Google Analytics").
# GA_MEASUREMENT_ID=G-7E21D47FY7

# Optional: when set, all /api/* requests must include header X-API-Key: <value>.
# Use for server-side calls (cron, webhooks). Do NOT store in mobile/web client.
# API_SECRET=

# Discord webhooks (create one webhook per channel: Integrations → Webhooks → New Webhook → Copy URL)
# DISCORD_WEBHOOK_URL=
# DISCORD_ERRORS_WEBHOOK_URL=       # #error-logs — falls back to DISCORD_WEBHOOK_URL if unset
# DISCORD_REGISTRATIONS_WEBHOOK_URL=  # #new-users — successful signups (minimal PII by default)
# DISCORD_PAYMENTS_WEBHOOK_URL=        # #payment-info — paid sub started / canceled (not renewals)
# DISCORD_REGISTRATION_INCLUDE_EMAIL=false  # true = full email in registration message
# Slack: Apps → Incoming Webhooks
